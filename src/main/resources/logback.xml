<configuration>
		<appender name="STDOUT"
				class="ch.qos.logback.core.ConsoleAppender">
				<encoder>
						<pattern>%d{HH:mm:ss.SSS} %-5level %logger{48} [%thread] - %msg%n
						</pattern>
				</encoder>
		</appender>

		<!-- Application logs are metadata-only: never model prompts, responses, 
				SQL binds, or credentials. -->
		<logger name="io.micronaut.oracle.dev" level="INFO" />
		<logger name="io.micronaut" level="INFO" />
		<root level="INFO">
				<appender-ref ref="STDOUT" />
		</root>
</configuration>
